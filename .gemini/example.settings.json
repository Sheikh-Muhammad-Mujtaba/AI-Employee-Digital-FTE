{
  "mcpServers": {
    "erpnext": {
      "command": "python",
      "args": [
        "-m",
        "ERP_Next-MCP.src.server"
      ],
      "cwd": "$ERPNEXT_MCP_PATH",
      "env": {
        "ERPNEXT_URL": "$ERPNEXT_URL",
        "ERPNEXT_USERNAME": "$ERPNEXT_USERNAME",
        "ERPNEXT_PASSWORD": "$ERPNEXT_PASSWORD",
        "ERPNEXT_API_KEY": "$ERPNEXT_API_KEY",
        "ERPNEXT_API_SECRET": "$ERPNEXT_API_SECRET"
      }
    },
    "browser": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/browser-mcp"
      ],
      "env": {
        "HEADLESS": "$BROWSER_MCP_HEADLESS"
      }
    },
    "windows-mcp": {
      "command": "uvx",
      "args": [
        "windows-mcp"
      ],
      "env": {
        "ANONYMIZED_TELEMETRY": "false"
      }
    }
  }
}